POSTGRES_USER=nexo
POSTGRES_PASSWORD=nexo-local-db
POSTGRES_DB=nexo
RABBITMQ_USER=nexo
RABBITMQ_PASSWORD=nexo-local-broker
REDIS_PASSWORD=nexo-local-cache
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://nexo:nexo-local-db@localhost:5432/nexo
RABBITMQ_URL=amqp://nexo:nexo-local-broker@localhost:5672/
REDIS_URL=redis://:nexo-local-cache@localhost:6379/0
RATE_LIMIT_PER_MINUTE=60
WORKER_MAX_ATTEMPTS=3
